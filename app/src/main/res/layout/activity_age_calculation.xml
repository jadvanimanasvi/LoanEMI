<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:orientation="vertical">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/background_color"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="22dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="@null"
            android:src="@drawable/back_ic"
            app:tint="@color/history_txt" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="12dp"
            android:text="@string/age_calculator"
            android:textColor="@color/history_txt"
            android:textSize="22sp"
            android:textStyle="bold" />

    </com.google.android.material.appbar.MaterialToolbar>


    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">


        <LinearLayout
            android:id="@+id/dobCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/cash_fild_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDobLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/date_of_birth"
                android:textColor="@color/length_txt"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/dobInputLayout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/ivCalendar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/calendar_ic"
                    app:tint="@color/reset_txt" />

                <EditText
                    android:id="@+id/etDob"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:focusable="false"
                    android:hint="DD/MM/YYYY"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:text="15/04/2000"
                    android:textColor="@color/history_txt"
                    android:textColorHint="@color/grey"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/btnClear"
                    android:layout_width="20dp"
                    android:layout_height="25dp"
                    android:contentDescription="@null"
                    android:src="@drawable/close_img"
                    app:tint="@color/grey" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivCalculate"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/calculator_ic"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvCalculate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/calculate_age"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/cash_fild_bg"
            android:orientation="vertical"
            android:padding="12dp">


            <LinearLayout
                android:id="@+id/resultTitleLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <FrameLayout
                    android:id="@+id/ageIconContainer"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_circle_blue">

                    <ImageView
                        android:id="@+id/ivAgeProfile"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/age_profile_ic"
                        app:tint="@color/blue" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/ageTitleLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvYourAge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/your_age"
                        android:textColor="@color/history_txt"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAsOf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/as_of_today"
                        android:textColor="@color/grey"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/ageDetailsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">


                <LinearLayout
                    android:id="@+id/ageValuesLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <LinearLayout
                        android:id="@+id/yearsLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/yearsIconContainer"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_circle_blue">

                            <ImageView
                                android:id="@+id/ivYears"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/calendar_ic"
                                app:tint="@color/blue" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvYearsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/years"
                            android:textColor="@color/reset_txt"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvYears"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="26"
                            android:textColor="@color/length_txt"
                            android:textSize="38sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- DIVIDER -->

                    <View
                        android:id="@+id/dividerOne"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="#CFE0F7" />


                    <!-- MONTHS -->

                    <LinearLayout
                        android:id="@+id/monthsLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/monthsIconContainer"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_circle_purple">

                            <ImageView
                                android:id="@+id/ivMonths"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/calendar_ic"
                                app:tint="@color/fd_icon" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvMonthsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/months"
                            android:textColor="@color/reset_txt"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvMonths"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="5"
                            android:textColor="@color/length_txt"
                            android:textSize="38sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- DIVIDER -->

                    <View
                        android:id="@+id/dividerTwo"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="#CFE0F7" />


                    <!-- DAYS -->

                    <LinearLayout
                        android:id="@+id/daysLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/daysIconContainer"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_circle_green">

                            <ImageView
                                android:id="@+id/ivDays"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/clock_ic"
                                app:tint="@color/icon_green" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvDaysLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/days"
                            android:textColor="@color/reset_txt"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvDays"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="13"
                            android:textColor="@color/length_txt"
                            android:textSize="38sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/nextBirthdayCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/cash_fild_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:id="@+id/birthdayIconContainer"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_blue">

                        <ImageView
                            android:id="@+id/ivBirthday"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/cake_ic"
                            app:tint="@color/blue" />

                    </FrameLayout>

                    <View
                        android:id="@+id/birthdayDivider"
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="14dp"
                        android:background="#CFE0F7" />

                    <LinearLayout
                        android:id="@+id/birthdayTextLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNextBirthdayLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/next_birthday"
                            android:textColor="@color/history_txt"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/birthdayInfoLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvNextBirthday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15 Apr 2027"
                                android:textColor="@color/grey"
                                android:textSize="14sp" />

                            <View
                                android:id="@+id/birthdayInfoDivider"
                                android:layout_width="1dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="10dp"
                                android:background="@color/grey" />

                            <TextView
                                android:id="@+id/tvDaysLeft"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="In 197 days"
                                android:textColor="@color/grey"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/bannerContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/screen_bg"
        android:gravity="center">

        <include
            android:id="@+id/bannerShimmer"
            layout="@layout/banner_shimmer_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </FrameLayout>

</LinearLayout>