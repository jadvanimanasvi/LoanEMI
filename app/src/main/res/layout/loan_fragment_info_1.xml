<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_25sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textSize="@dimen/_20ssp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textColor="@color/text_color"
        android:text="@string/smart_gallery_for_every_moment" />


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imgOnboarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@id/tvDescription" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:textSize="@dimen/_15ssp"
        android:textColor="@color/text_color"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgOnboarding"
        app:layout_constraintBottom_toTopOf="@id/rlnext"
        android:text="@string/all_your_memories_organized_beautifully_in_one_place" />

    <RelativeLayout
        android:id="@+id/rlnext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        app:layout_constraintBottom_toTopOf="@id/layoutAdNative"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_gravity="right"
            android:layout_marginEnd="14dp"
            android:text="@string/next"
            android:textAllCaps="false"
            android:textColor="@color/blue"
            android:textStyle="bold"
            android:textSize="19sp"
            tools:ignore="RtlHardcoded" />

        <ImageView
            android:id="@+id/lottieView"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_alignTop="@+id/btnNext"
            android:layout_alignBottom="@+id/btnNext"
            android:layout_alignParentEnd="true"
            android:layout_gravity="right"
            android:layout_marginEnd="1dp"
            android:visibility="invisible"
            tools:ignore="ContentDescription,RtlHardcoded" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/agreeContainer"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/_10sdp"
            android:visibility="gone"
            app:cardCornerRadius="35dp"
            app:cardUseCompatPadding="false">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_get_started_button">

                <View
                    android:id="@+id/shine"
                    android:layout_width="60dp"
                    android:layout_height="55dp"
                    android:layout_gravity="center_vertical"
                    android:alpha="0.7"
                    android:background="@drawable/shine_gradient"
                    android:rotation="15" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@android:color/transparent"
                    android:text="@string/next"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>
    <FrameLayout
        android:id="@+id/layoutAdNative"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_80sdp"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <include
            android:id="@+id/layouinclude"
            layout="@layout/native_shimmer_medium_new" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>